# CyberMesh Configuration Template

# Server Port
PORT=5000

# Client Application URL (CORS allowed origin)
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL connection string)
# Example: postgresql://postgres:postgres@localhost:5432/cybermesh
# If empty or unreachable, the system automatically uses embedded PostgreSQL mode
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cybermesh

# JWT Security
JWT_SECRET=cybermesh_super_secret_jwt_key_academic_demo_2026
JWT_EXPIRES_IN=8h

# AI Service Gateway
AI_SERVICE_URL=http://localhost:8000

# Optional External LLM Key (Not required for local deterministic extraction & classification)
LLM_API_KEY=mock-academic-key

# Node Environment
NODE_ENV=development
